RECOVERY_MODE=offline
RECOVERY_MAX_DEBIT_PAISE=500
RECOVERY_OPERATOR_TOKEN=

# Required when RECOVERY_MODE=live. Live mode fails closed if any is missing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Authorises real debits. Only the literal "yes". Requires RECOVERY_OPERATOR_TOKEN.
RECOVERY_LIVE_DEBIT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECOVERY_NOTIFY_EMAIL=

RAZORPAY_DEFAULT_EMAIL=
RAZORPAY_DEFAULT_CONTACT=
RAZORPAY_TEST_TOKEN_ID=
RAZORPAY_TEST_CUSTOMER_ID=
RAZORPAY_TEST_AMOUNT_PAISE=49900
RAZORPAY_MANDATE_MAX_PAISE=4990000
RAZORPAY_MAX_LIVE_NUDGES=5

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
